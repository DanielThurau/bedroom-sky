# Public demo at San Francisco International Airport; these are not home coordinates.
# Copy to .env and edit locally. Never commit your personal .env.
BEDROOM_SKY_LATITUDE=37.6213
BEDROOM_SKY_LONGITUDE=-122.3790
BEDROOM_SKY_ELEVATION_M=4
BEDROOM_SKY_HEADING_DEG=0
BEDROOM_SKY_PITCH_DEG=5
BEDROOM_SKY_FOV_DEG=70
BEDROOM_SKY_ROOM_HEADING_DEG=0
# The settings panel and minimap can still reveal your location in screenshots.
BEDROOM_SKY_SHOW_LOCATION=false
BEDROOM_SKY_FLIGHT_RADIUS_NM=50
